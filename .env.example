HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Set true only behind the reviewed Caddyfile on a loopback-bound HTTPS host.
# Caddy overwrites X-MineMine-Client-IP so API limits count visitors separately.
TRUST_LOOPBACK_PROXY=false
# Sepolia; no mainnet transactions are enabled by the deployment script.
CHAIN_ID=11155111
RPC_URL=
# ENS resolves on Ethereum mainnet, even when MINE is on Sepolia.
ENS_RPC_URL=
# Public wallet addresses only. Set after proving parent control and granting
# the writer ETH-address permission on a managed ENSv2 Permissioned Resolver.
ENS_EXPECTED_OWNER=
ENS_NAME_WRITER_ADDRESS=
# Optional local Stripe test-mode webhook rehearsal only. Keep real values out of git.
# Live-mode keys are rejected, and the checkout creator has no player route yet.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
NAME_CHECKOUT_TEST_ENABLED=false
# Comma-separated wallet addresses allowed to read the private admin stats API.
# Leave empty until the owner chooses admin wallets; this does not grant Luanti privileges.
ADMIN_WALLET_ADDRESSES=
# Keep false until beta codes are issued and invited/uninvited clients are tested.
# When true, shared-world tickets and the game WebSocket require a redeemed code or an admin wallet.
BETA_INVITES_ENABLED=false
TOKEN_ADDRESS=
TOWN_CONTRACT_ADDRESS=
# Sepolia needs several blocks before land credits become usable. Use 0 only on a local chain.
TOWN_CONFIRMATIONS=6
# Testnet deployment only: whole/decimal MINE price per protected x/z world column.
TOWN_PRICE_PER_BLOCK=1
TOWN_TREASURY=
# Grants live inside the Luanti world so the mod needs no insecure filesystem access.
WORLD_DIR=./runtime/world
# Keep disabled until the engine, game, auth mod, and private proxy pass end-to-end tests.
GAME_ENABLED=false
GAME_ADDRESS=10.0.0.1
GAME_PORT=30000
# Keep false until the adapter, proxy, native server, and two-player smoke test pass.
ENGINE_ADAPTER_READY=false
# For contract deployment only; use an isolated testnet wallet. Never commit this value.
DEPLOYER_PRIVATE_KEY=
TOKEN_TREASURY=
