[Unit]
Description=Project verified MineMine wallet profiles to SpacetimeDB
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=minemine
Group=minemine
WorkingDirectory=/srv/minemine/app
EnvironmentFile=/etc/minemine/minemine.env
ExecStart=/usr/bin/node /srv/minemine/app/scripts/sync-spacetime-profiles.mjs
TimeoutStartSec=20min
UMask=0077
Nice=10
ProtectSystem=strict
ReadWritePaths=/srv/minemine/world
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
