{
  "name": "miners-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser Luanti research build with Ethereum wallet authentication and testnet currency",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "test:http": "node --test test/integration/socket.mjs",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:deploy": "node --env-file-if-exists=.env scripts/deploy-token.mjs",
    "doctor": "node scripts/doctor.mjs",
    "upstream:fetch": "node scripts/fetch-upstream.mjs"
  },
  "dependencies": { "ethers": "6.16.0" },
  "devDependencies": { "@openzeppelin/contracts": "4.9.6", "solc": "0.8.26" }
}
