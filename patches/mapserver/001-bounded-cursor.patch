diff --git a/db/sqlite/cursor_test.go b/db/sqlite/cursor_test.go
new file mode 100644
index 0000000..53cb7b0
--- /dev/null
+++ b/db/sqlite/cursor_test.go
@@ -0,0 +1,101 @@
+package sqlite
+
+import (
+	"database/sql"
+	"fmt"
+	"mapserver/db"
+	"mapserver/testutils"
+	"mapserver/types"
+	"mapserver/util"
+	"path/filepath"
+	"testing"
+)
+
+func TestMtimeCursorDrainsSameTimestampAcrossPages(t *testing.T) {
+	for _, legacy := range []bool{false, true} {
+		t.Run(fmt.Sprintf("legacy=%t", legacy), func(t *testing.T) {
+			filename := filepath.Join(t.TempDir(), "map.sqlite")
+			if legacy {
+				testutils.CreateEmptyLegacyDatabase(filename)
+			} else {
+				testutils.CreateEmptyDatabase(filename)
+			}
+			accessor, err := New(filename)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer accessor.db.Close()
+			if err := accessor.Migrate(); err != nil {
+				t.Fatal(err)
+			}
+
+			writer, err := sql.Open("sqlite", filename+"?mode=rw")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer writer.Close()
+			// The real trigger uses second-resolution timestamps. Seed a
+			// deterministic same-second burst after migration.
+			if _, err := writer.Exec("DROP TRIGGER update_blocks_mtime_insert; DROP TRIGGER update_blocks_mtime_update"); err != nil {
+				t.Fatal(err)
+			}
+			tx, err := writer.Begin()
+			if err != nil {
+				t.Fatal(err)
+			}
+			query := "INSERT INTO blocks (x,y,z,data,mtime) VALUES (?,?,?,?,?)"
+			if legacy {
+				query = "INSERT INTO blocks (pos,data,mtime) VALUES (?,?,?)"
+			}
+			insert, err := tx.Prepare(query)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for i := 0; i < 343; i++ {
+				if legacy {
+					_, err = insert.Exec(util.CoordToPlain(types.NewMapBlockCoords(i, 0, 0)), []byte{}, 1000)
+				} else {
+					_, err = insert.Exec(i, 0, 0, []byte{}, 1000)
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			insert.Close()
+			if err := tx.Commit(); err != nil {
+				t.Fatal(err)
+			}
+
+			cursor := db.BlockCursor{Mtime: 999}
+			pending, err := accessor.FindBlocksByMtime(cursor, 1000, 128)
+			if err != nil || len(pending) != 0 {
+				t.Fatalf("current timestamp must wait, got %d blocks and %v", len(pending), err)
+			}
+			seen := make(map[int]bool)
+			for _, want := range []int{128, 128, 87} {
+				page, err := accessor.FindBlocksByMtime(cursor, 1001, 128)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if len(page) != want {
+					t.Fatalf("page has %d blocks, want %d", len(page), want)
+				}
+				for _, block := range page {
+					if seen[block.Pos.X] {
+						t.Fatalf("duplicate mapblock %d", block.Pos.X)
+					}
+					seen[block.Pos.X] = true
+				}
+				last := page[len(page)-1]
+				cursor = db.BlockCursor{Mtime: last.Mtime, Pos: last.Pos}
+			}
+			if len(seen) != 343 {
+				t.Fatalf("only saw %d of 343 blocks", len(seen))
+			}
+			page, err := accessor.FindBlocksByMtime(cursor, 1001, 128)
+			if err != nil || len(page) != 0 {
+				t.Fatalf("expected cursor to be drained, got %d blocks and %v", len(page), err)
+			}
+		})
+	}
+}
