+const createDirtyQueueXYZ = `
+	CREATE TABLE IF NOT EXISTS mapserver_change_counter (
+		id INTEGER PRIMARY KEY CHECK (id = 1), seq INTEGER NOT NULL
+	);
+	INSERT OR IGNORE INTO mapserver_change_counter(id, seq) VALUES (1, 0);
+	CREATE TABLE IF NOT EXISTS mapserver_dirty (
+		x INTEGER NOT NULL, y INTEGER NOT NULL, z INTEGER NOT NULL,
+		seq INTEGER NOT NULL, PRIMARY KEY (x, y, z)
+	);
+	CREATE INDEX IF NOT EXISTS mapserver_dirty_seq ON mapserver_dirty(seq);
+	CREATE TRIGGER IF NOT EXISTS mapserver_dirty_insert AFTER INSERT ON blocks BEGIN
+		UPDATE mapserver_change_counter SET seq = seq + 1 WHERE id = 1;
+		INSERT OR REPLACE INTO mapserver_dirty(x, y, z, seq)
+			VALUES (NEW.x, NEW.y, NEW.z, (SELECT seq FROM mapserver_change_counter WHERE id = 1));
+	END;
+	CREATE TRIGGER IF NOT EXISTS mapserver_dirty_update AFTER UPDATE OF data ON blocks BEGIN
+		UPDATE mapserver_change_counter SET seq = seq + 1 WHERE id = 1;
