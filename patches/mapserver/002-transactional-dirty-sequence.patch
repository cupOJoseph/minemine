+func TestDirtySequenceSeesDelayedCommitAndReplayedEdit(t *testing.T) {
+	for _, legacy := range []bool{false, true} {
+		t.Run(fmt.Sprintf("legacy=%t", legacy), func(t *testing.T) {
+			filename := filepath.Join(t.TempDir(), "map.sqlite")
+			if legacy {
+				testutils.CreateEmptyLegacyDatabase(filename)
+			} else {
+				testutils.CreateEmptyDatabase(filename)
+			}
+			accessor, err := New(filename)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer accessor.db.Close()
+			if err := accessor.Migrate(); err != nil {
+				t.Fatal(err)
+			}
+			writer, err := sql.Open("sqlite", filename+"?mode=rw")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer writer.Close()
+			insert := "INSERT INTO blocks(x,y,z,data) VALUES (?,0,0,?)"
+			if legacy {
+				insert = "INSERT INTO blocks(pos,data) VALUES (?,?)"
+			}
+			position := func(x int) int64 {
+				if legacy {
+					return util.CoordToPlain(types.NewMapBlockCoords(x, 0, 0))
+				}
+				return int64(x)
+			}
+			if _, err := writer.Exec(insert, position(200), []byte("first")); err != nil {
+				t.Fatal(err)
+			}
+			tx, err := writer.Begin()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer tx.Rollback()
+			if _, err := tx.Exec(insert, position(100), []byte("late")); err != nil {
+				t.Fatal(err)
+			}
+			first, err := accessor.FindBlocksByMtime(db.BlockCursor{}, 0, 128)
+			if err != nil || len(first) != 1 || first[0].Pos.X != 200 {
+				t.Fatalf("uncommitted block must be invisible: %v, %v", first, err)
+			}
+			if err := tx.Commit(); err != nil {
+				t.Fatal(err)
+			}
+			cursor := db.BlockCursor{Seq: first[0].Seq}
+			second, err := accessor.FindBlocksByMtime(cursor, 0, 128)
+			if err != nil || len(second) != 1 || second[0].Pos.X != 100 {
+				t.Fatalf("delayed commit must appear after cursor: %v, %v", second, err)
+			}
+			update := "UPDATE blocks SET data = ? WHERE x = ? AND y = 0 AND z = 0"
+			if legacy {
+				update = "UPDATE blocks SET data = ? WHERE pos = ?"
+			}
+			if _, err := writer.Exec(update, []byte("again"), position(200)); err != nil {
+				t.Fatal(err)
+			}
+			cursor.Seq = second[0].Seq
+			third, err := accessor.FindBlocksByMtime(cursor, 0, 128)
+			if err != nil || len(third) != 1 || third[0].Pos.X != 200 || string(third[0].Data) != "again" {
+				t.Fatalf("edit after cursor must reappear: %v, %v", third, err)
+			}
 		})
 	}
 }
